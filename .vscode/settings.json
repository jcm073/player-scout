        "/^python3 -c 'exec\\(\"\"\"from pathlib import Path\nimport yaml\n\nroot = Path\\.cwd\\(\\)\nroles = \\{\"rust-specialist\", \"frontend-specialist\", \"ux-specialist\", \"postgres-dba\", \"mobile-specialist\", \"security-specialist\"\\}\nerrors = \\[\\]\nfor cli in \\(\"\\.claude/agents\", \"\\.gemini/agents\"\\):\n    files = sorted\\(\\(root / cli\\)\\.glob\\(\"\\*\\.md\"\\)\\)\n    names = set\\(\\)\n    if not files:\n        errors\\.append\\(f\"\\{cli\\}: nenhum arquivo \\.md encontrado\"\\)\n    for path in files:\n        lines = path\\.read_text\\(encoding=\"utf-8\"\\)\\.splitlines\\(\\)\n        if len\\(lines\\) < 3 or lines\\[0\\]\\.strip\\(\\) != \"---\" or \"---\" not in lines\\[1:\\]:\n            errors\\.append\\(f\"\\{path\\}: frontmatter ausente ou delimitadores inválidos\"\\)\n            continue\n        end = lines\\.index\\(\"---\", 1\\)\n        try:\n            metadata = yaml\\.safe_load\\(\"\\\\\\\\n\"\\.join\\(lines\\[1:end\\]\\)\\)\n        except yaml\\.YAMLError as exc:\n            errors\\.append\\(f\"\\{path\\}: YAML inválido: \\{exc\\}\"\\)\n            continue\n        if not isinstance\\(metadata, dict\\):\n            errors\\.append\\(f\"\\{path\\}: frontmatter não é um mapa YAML\"\\)\n            continue\n        name = metadata\\.get\\(\"name\"\\)\n        description = metadata\\.get\\(\"description\"\\)\n        if not isinstance\\(name, str\\) or not name:\n            errors\\.append\\(f\"\\{path\\}: name ausente\"\\)\n        elif name in names:\n            errors\\.append\\(f\"\\{path\\}: name duplicado: \\{name\\}\"\\)\n        else:\n            names\\.add\\(name\\)\n        if not isinstance\\(description, str\\) or not description\\.strip\\(\\):\n            errors\\.append\\(f\"\\{path\\}: description ausente ou vazia\"\\)\n        if cli == \"\\.gemini/agents\":\n            if metadata\\.get\\(\"kind\", \"local\"\\) != \"local\":\n                errors\\.append\\(f\"\\{path\\}: kind não é local\"\