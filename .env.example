# Player Scout: Configuração de Ambiente Local (Exemplo)
# ATENÇÃO: Copie este arquivo para .env e altere a senha antes de iniciar o Compose

POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DB=playerscout_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:sua_senha_segura_aqui@localhost:5432/playerscout_dev

# Configurações do Backend Rust
RUST_LOG=info,player_scout=debug
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Configurações OAuth2 (Google/Gmail, Microsoft Office e Instagram)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/microsoft/callback
OAUTH_INSTAGRAM_CLIENT_ID=
OAUTH_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/instagram/callback
